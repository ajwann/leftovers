{
  "description": "leftovers: catch debug/test leftovers Claude added before it stops",
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook.py"], "timeout": 30}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/hook.py"], "timeout": 30}]}
    ]
  }
}
